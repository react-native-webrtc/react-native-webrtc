From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: filipi87 <filipi87@gmail.com>
Date: Thu, 29 Oct 2026 12:37:28 -0700
Subject: [PATCH] event-target-shim-imports: import from 'event-target-shim'
 package root

'event-target-shim/index' breaks resolution with newer bundlers/TypeScript.
Also adds the missing final newline in RTCErrorEvent.ts.
---
 src/MediaDevices.ts          | 2 +-
 src/MediaStream.ts           | 2 +-
 src/MediaStreamTrack.ts      | 2 +-
 src/MediaStreamTrackEvent.ts | 2 +-
 src/MessageEvent.ts          | 2 +-
 src/RTCDataChannel.ts        | 2 +-
 src/RTCDataChannelEvent.ts   | 2 +-
 src/RTCErrorEvent.ts         | 4 ++--
 src/RTCIceCandidateEvent.ts  | 2 +-
 src/RTCPeerConnection.ts     | 2 +-
 src/RTCTrackEvent.ts         | 2 +-
 11 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/src/MediaDevices.ts b/src/MediaDevices.ts
index c647667..42920f6 100644
--- a/src/MediaDevices.ts
+++ b/src/MediaDevices.ts
@@ -1,4 +1,4 @@
-import { EventTarget, Event, defineEventAttribute } from 'event-target-shim/index';
+import { EventTarget, Event, defineEventAttribute } from 'event-target-shim';
 import { NativeModules } from 'react-native';
 
 import getDisplayMedia from './getDisplayMedia';
