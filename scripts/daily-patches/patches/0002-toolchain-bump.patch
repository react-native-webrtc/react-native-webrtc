From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: filipi87 <filipi87@gmail.com>
Date: Thu, 29 Oct 2026 12:37:27 -0700
Subject: [PATCH] toolchain-bump: update TypeScript, builder-bob and React
 typings

typescript 5.8.3, react-native-builder-bob 0.39.1, @types/react 19.0.9,
@types/react-native 0.73.0, and restrict tsconfig 'types' to react,
react-native and debug. RTCPIPView fallbackView becomes React.ReactNode, which
@types/react 19 requires. package-lock.json is regenerated, not patched.
---
 package.json       | 8 ++++----
 src/RTCPIPView.tsx | 6 +++---
 tsconfig.json      | 1 +
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/package.json b/package.json
index 67c4cfb..973acdd 100644
--- a/package.json
+++ b/package.json
@@ -41,8 +41,8 @@
   },
   "devDependencies": {
     "@types/debug": "4.1.7",
-    "@types/react": "17.0.40",
-    "@types/react-native": "0.67.3",
+    "@types/react": "19.0.9",
+    "@types/react-native": "0.73.0",
     "@typescript-eslint/eslint-plugin": "^5.39.0",
     "@typescript-eslint/parser": "^5.39.0",
     "eslint": "^8.24.0",
@@ -50,8 +50,8 @@
     "husky": "7.0.2",
     "lint-staged": "11.2.3",
     "prettier": "2.4.1",
-    "react-native-builder-bob": "0.18.2",
-    "typescript": "4.6.2"
+    "react-native-builder-bob": "0.39.1",
+    "typescript": "5.8.3"
   },
   "lint-staged": {
     "**/*": "prettier --write --ignore-unknown"
diff --git a/src/RTCPIPView.tsx b/src/RTCPIPView.tsx
index 462f888..bfc08c2 100644
--- a/src/RTCPIPView.tsx
+++ b/src/RTCPIPView.tsx
@@ -1,11 +1,11 @@
-import { Component, forwardRef } from 'react';
+import { forwardRef } from 'react';
 import ReactNative, { UIManager } from 'react-native';
 
 import RTCView, { RTCIOSPIPOptions, RTCVideoViewProps } from './RTCView';
 
 export interface RTCPIPViewProps extends RTCVideoViewProps {
   iosPIP?: RTCIOSPIPOptions & {
-    fallbackView?: Component;
+    fallbackView?: React.ReactNode;
   };
 }
 
@@ -44,4 +44,4 @@ export function stopIOSPIP(ref) {
     );
 }
 
-export default RTCPIPView;
\ No newline at end of file
+export default RTCPIPView;
diff --git a/tsconfig.json b/tsconfig.json
index c853664..1645b2e 100644
--- a/tsconfig.json
+++ b/tsconfig.json
@@ -11,6 +11,7 @@
       "noImplicitAny": false,
       "allowSyntheticDefaultImports": true,
       "esModuleInterop": true,
+      "types": ["react", "react-native", "debug"]
     },
     "exclude": ["node_modules"]
 }
